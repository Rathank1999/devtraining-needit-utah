        <script><![CDATA[var NeedItUtils = Class.create();
NeedItUtils.prototype = {
    initialize: function() {},

    isDateToday: function(strDate) {
        if (!strDate) {
            return false; // Return false if no date is provided
        }

        var today = new GlideDateTime();
        today.setDisplayValue(today.getLocalDate()); // Get only today's date (ignore time)
        
        var givenDate = new GlideDateTime(strDate);
        givenDate.setDisplayValue(givenDate.getLocalDate()); // Normalize input date

        return today.getDisplayValue() === givenDate.getDisplayValue();
    },

    type: 'NeedItUtils'
};
]]></script>
